<aside class="grounding-page__human-notice" role="note"
       aria-label="{{ 'grounding.humanNotice.label'|trans([], 'contao_default') }}">
    <p class="grounding-page__human-notice-title">{{ 'grounding.humanNotice.label'|trans([], 'contao_default') }}</p>
    <p class="grounding-page__human-notice-text">{{ 'grounding.humanNotice.text'|trans([], 'contao_default') }}</p>
    <p class="grounding-page__human-notice-links">
        <span>{{ 'grounding.humanNotice.introLabel'|trans([], 'contao_default') }}</span>
        <a href="/">{{ 'grounding.humanNotice.introLinkText'|trans([], 'contao_default') }}</a>
        <span>{{ 'grounding.humanNotice.aboutLabel'|trans([], 'contao_default') }}</span>
        <a href="https://groundingpage.com/" rel="noopener" target="_blank">{{ 'grounding.humanNotice.aboutLinkText'|trans([], 'contao_default') }}</a>
    </p>
</aside>
