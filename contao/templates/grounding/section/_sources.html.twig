{# Kennungen stehen seit Standard 2.0 in _official_profiles (RI-5); section.identifiers bleibt für Overrides im DTO. #}
<section class="grounding-page grounding-page__sources">
    <h2>{{ section.sectionTitle ?: 'grounding.detail.sourcesNamed'|trans([name|default('')], 'contao_default') }}</h2>

    {% if section.sources %}
        <ul class="grounding-page__source-list">
            {% for source in section.sources %}
                {% if source.url starts with 'https://' or source.url starts with 'http://' %}
                    <li><a href="{{ source.url }}" rel="nofollow noopener">{{ source.title ?: source.url }}</a></li>
                {% elseif source.title %}
                    <li>{{ source.title }}</li>
                {% endif %}
            {% endfor %}
        </ul>
    {% endif %}
</section>
