includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: 6

    paths:
        - src
        - tests

    # Contao-Legacy-Models leben in contao/models (kein PSR-4) — für PHPStan bekannt machen.
    scanDirectories:
        - contao/models

    universalObjectCratesClasses:
        - Contao\Model
        - Contao\Template

    ignoreErrors:
        - identifier: missingType.iterableValue

        # Contao-Legacy-Muster in Tests: $GLOBALS-DCA-Arrays sind `mixed`, Legacy-Model-
        # Zugriffe und bewusst überspezifische Assertions. src/ bleibt unberührt streng (Level 6).
        - { identifier: offsetAccess.notFound, path: tests/* }
        - { identifier: method.impossibleType, path: tests/* }
        - { identifier: method.alreadyNarrowedType, path: tests/* }
        - { identifier: function.alreadyNarrowedType, path: tests/* }
